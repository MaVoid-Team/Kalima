generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes", "relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model auth_identities {
  id               Int                @id @default(autoincrement())
  user_id          Int
  provider         auth_provider_enum
  provider_user_id String             @db.VarChar
  provider_email   String?            @db.VarChar
  users            users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, provider_user_id])
}

model user_analytics {
  user_id                     Int       @id
  views                       Int?      @default(0)
  total_spent                 Decimal?  @default(0) @db.Decimal(14, 2)
  number_of_purchases         Int?      @default(0)
  successful_invites          Int?      @default(0)
  monthly_confirmed_count     Int?      @default(0)
  last_confirmed_count_update DateTime? @default(now()) @db.Timestamptz(6)
  users                       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_roles {
  id      Int         @id @default(autoincrement())
  user_id Int
  portal  portal_enum
  role    role_enum
  users   users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, portal, role])
}

model users {
  id                        Int                        @id @default(autoincrement())
  mongo_id                  String?                    @unique
  name                      String                     @db.VarChar
  email                     String?                    @unique @db.VarChar
  password                  String?                    @db.VarChar
  phone                     String?                    @db.VarChar
  gender                    gender_enum?
  is_email_verified         Boolean?                   @default(false)
  created_at                DateTime?                  @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                  @default(now()) @db.Timestamptz(6)
  secondary_phone           String?                    @db.VarChar
  profile_pic_url           String?
  password_changed_at       DateTime?                  @db.Timestamp(6)
  confirmed                 Boolean?                   @default(false)
  hasPromoCode              Boolean?                   @default(false)
  hasUsedPromoCode          Boolean?                   @default(false)
  email_verified_at         DateTime?                  @db.Timestamptz(6)
  role                      role_enum?
  created_by                Int?
  assistants                assistants[]
  auth_identities           auth_identities[]
  email_verification_tokens email_verification_tokens?
  lecturers                 lecturers?
  parents                   parents?
  password_reset_tokens     password_reset_tokens?
  refresh_tokens            refresh_tokens[]
  social_media              social_media[]
  students                  students?
  teachers                  teachers?
  teaches_at                teaches_at[]
  user_analytics            user_analytics?
  user_roles                user_roles[]
  carts                     carts[]
  purchases                 purchases[]                @relation("PurchaseCreator")
  purchases_received        purchases[]                @relation("PurchaseReceiver")
  purchases_confirmed       purchases[]                @relation("PurchaseConfirmer")
  purchases_returned        purchases[]                @relation("PurchaseReturner")
  coupon_usages             coupon_usages[]
  creator_user              users?                     @relation("UserCreator", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  created_users             users[]                    @relation("UserCreator")

  @@index([mongo_id], map: "ix_users_mongo_id")
}

model refresh_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @db.VarChar
  revoked    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "ix_refresh_tokens_user")
}

model assistants {
  id               Int       @id @default(autoincrement())
  user_id          Int
  lecturer_user_id Int
  lecturers        lecturers @relation(fields: [lecturer_user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model government {
  id       Int        @id @default(autoincrement())
  title    String     @unique @db.VarChar(255)
  active   Boolean?   @default(true)
  parents  parents[]
  students students[]
  teachers teachers[]
  zones    zones[]
}

model lecturers {
  user_id    Int          @id
  bio        String?
  expertise  String?
  assistants assistants[]
  users      users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model levels {
  id       Int        @id @default(autoincrement())
  title    String     @unique @db.VarChar(255)
  active   Boolean?   @default(true)
  students students[]
}

model parent_children {
  id              Int      @id @default(autoincrement())
  parent_user_id  Int
  student_user_id Int
  parents         parents  @relation(fields: [parent_user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  students        students @relation(fields: [student_user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([parent_user_id, student_user_id])
}

model parents {
  user_id         Int               @id
  government_id   Int?
  zone_id         Int?
  parent_children parent_children[]
  government      government?       @relation(fields: [government_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  zones           zones?            @relation(fields: [zone_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model sites {
  id           Int            @id @default(autoincrement())
  title        String         @unique @db.VarChar(255)
  active       Boolean?       @default(true)
  social_media social_media[]
}

model social_media {
  id              Int      @id @default(autoincrement())
  teacher_user_id Int
  site_id         Int?
  url             String
  active          Boolean? @default(true)
  sites           sites?   @relation(fields: [site_id], references: [id], onUpdate: NoAction)
  users           users    @relation(fields: [teacher_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model students {
  user_id             Int               @id
  level_id            Int?
  government_id       Int?
  zone_id             Int?
  parent_phone_number String?           @db.VarChar(255)
  sequenced_id        Int?
  faction             String?           @db.VarChar(255)
  parent_children     parent_children[]
  government          government?       @relation(fields: [government_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levels              levels?           @relation(fields: [level_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  zones               zones?            @relation(fields: [zone_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model subjects {
  id       Int        @id @default(autoincrement())
  title    String     @unique @db.VarChar(255)
  active   Boolean?   @default(true)
  teachers teachers[]
}

model teachers {
  user_id        Int         @id
  serial         String?     @unique @db.VarChar(255)
  is_primary     Boolean?    @default(false)
  is_preparatory Boolean?    @default(false)
  is_secondary   Boolean?    @default(false)
  government_id  Int?
  zone_id        Int?
  subject_id     Int?
  government     government? @relation(fields: [government_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subjects       subjects?   @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  zones          zones?      @relation(fields: [zone_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model teaches_at {
  id            Int                 @id @default(autoincrement())
  user_id       Int
  location_name String?             @db.VarChar(255)
  location_type location_type_enum?
  active        Boolean?            @default(true)
  users         users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model zones {
  id            Int        @id @default(autoincrement())
  title         String     @db.VarChar(255)
  government_id Int
  active        Boolean?   @default(true)
  parents       parents[]
  students      students[]
  teachers      teachers[]
  government    government @relation(fields: [government_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([title, government_id])
}

model email_verification_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int       @unique
  token_hash String    @db.VarChar
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token_hash], map: "ix_email_verification_tokens_hash")
}

model password_reset_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int       @unique
  token_hash String    @db.VarChar
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token_hash], map: "ix_password_reset_tokens_hash")
}

model categories {
  id                 Int                  @id @default(autoincrement())
  title              String               @db.VarChar(255)
  active             Boolean?             @default(true)
  description        String?              @default("")
  parent_id          Int?
  mongo_id           String?              @unique
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @db.Timestamp(6)
  categories         categories?          @relation("categoriesTocategories", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_categories   categories[]         @relation("categoriesTocategories")
  product_categories product_categories[]
}

model product_categories {
  id          Int        @id @default(autoincrement())
  product_id  Int
  category_id Int
  products    products   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, category_id])
}

model coupons {
  id                  Int             @id @default(autoincrement())
  code                String          @unique @db.VarChar(50)
  discount_amount     Decimal?        @default(0) @db.Decimal(10, 2)
  discount_percentage Int?            @default(0)
  active              Boolean?        @default(true)
  starts_at           DateTime?       @db.Timestamp(6)
  expires_at          DateTime?       @db.Timestamp(6)
  created_at          DateTime?       @default(now()) @db.Timestamp(6)
  updated_at          DateTime?       @db.Timestamp(6)
  deleted_at          DateTime?       @db.Timestamp(6)
  mongo_id            String?         @unique
  products            products[]
  cart_items          cart_items[]
  coupon_usages       coupon_usages[]
}

model coupon_usages {
  id          Int        @id @default(autoincrement())
  user_id     Int
  coupon_id   Int
  purchase_id Int?
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  users       users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coupons     coupons    @relation(fields: [coupon_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchases   purchases? @relation(fields: [purchase_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([user_id, coupon_id])
}

model product_required_fields {
  id                         Int                        @id @default(autoincrement())
  product_id                 Int
  field_definition_id       Int
  is_required                Boolean?                   @default(true)
  active                     Boolean?                   @default(true)
  required_field_definitions required_field_definitions @relation(fields: [field_definition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products                   products                   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, field_definition_id])
  @@index([product_id, is_required, active], map: "ix_product_required_fields_product_active")
}

model products {
  id                      Int                       @id @default(autoincrement())
  title                   String                    @db.VarChar(255)
  description             String?
  type                    product_type_enum         @default(Product)
  price                   Decimal                   @default(0) @db.Decimal(10, 2)
  price_after_discount    Decimal?                  @db.Decimal(10, 2)
  serial                  String?                   @db.VarChar(255)
  thumbnail_id            Int?
  sample_url              String?
  coupon_id               Int?
  is_archived             Boolean?                  @default(false)
  mongo_id                String?                   @unique
  created_at              DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at              DateTime?                 @db.Timestamp(6)
  deleted_at              DateTime?                 @db.Timestamp(6)
  product_required_fields product_required_fields[]
  product_categories      product_categories[]
  product_gallery         product_gallery[]
  cart_items              cart_items[] // <-- Add this line for the relation
  purchase_items          purchase_items[] // <-- Add this line for the opposite relation
  thumbnail_image         images?                   @relation("ProductThumbnail", fields: [thumbnail_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  coupons                 coupons?                  @relation(fields: [coupon_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  samples                 samples?
}

model samples {
  id            Int       @id @default(autoincrement())
  product_id    Int       @unique
  url           String
  original_name String    @db.VarChar(255)
  mime_type     String    @db.VarChar(100)
  size          Int
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  products      products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model required_field_definitions {
  id                            Int                             @id @default(autoincrement())
  label                         String                          @unique @db.VarChar(255)
  field_type                    field_type_enum                 @default(text)
  active                        Boolean?                        @default(true)
  created_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  updated_at                    DateTime?                       @db.Timestamp(6)
  deleted_at                    DateTime?                       @db.Timestamp(6)
  product_required_fields       product_required_fields[]
  purchase_item_required_fields purchase_item_required_fields[]
  cart_item_required_fields     cart_item_required_fields[] // <-- Added missing opposite relation
}

model carts {
  id         Int          @id @default(autoincrement())
  user_id    Int
  status     String       @default("active")
  subtotal   Decimal      @default(0) @db.Decimal(10, 2)
  discount   Decimal      @default(0) @db.Decimal(10, 2)
  total      Decimal      @default(0) @db.Decimal(10, 2)
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  updated_at DateTime?    @db.Timestamp(6)
  deleted_at DateTime?    @db.Timestamp(6)
  cart_items cart_items[]
  users      users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model cart_items {
  id                        Int                         @id @default(autoincrement())
  cart_id                   Int
  product_id                Int
  coupon_id                 Int? // <-- Added coupon_id for relation to coupons
  quantity                  Int                         @default(1)
  price_at_add              Decimal                     @default(0) @db.Decimal(10, 2)
  final_price               Decimal                     @default(0) @db.Decimal(10, 2)
  discount                  Decimal                     @default(0) @db.Decimal(10, 2)
  required_fields_filled    Boolean                     @default(false)
  created_at                DateTime?                   @default(now()) @db.Timestamp(6)
  updated_at                DateTime?                   @db.Timestamp(6)
  deleted_at                DateTime?                   @db.Timestamp(6)
  carts                     carts                       @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products                  products                    @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coupons                   coupons?                    @relation(fields: [coupon_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  cart_item_required_fields cart_item_required_fields[]

  @@index([cart_id], map: "ix_cart_items_cart_id")
}

model cart_item_required_fields {
  id                         Int                        @id @default(autoincrement())
  cart_item_id               Int
  field_definition_id        Int
  value                      String
  created_at                 DateTime?                  @default(now()) @db.Timestamp(6)
  updated_at                 DateTime?                  @db.Timestamp(6)
  cart_items                 cart_items                 @relation(fields: [cart_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  required_field_definitions required_field_definitions @relation(fields: [field_definition_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model purchases {
  id                      Int              @id @default(autoincrement())
  user_id                 Int
  status                  String           @default("pending")
  subtotal                Decimal          @default(0) @db.Decimal(10, 2)
  discount                Decimal          @default(0) @db.Decimal(10, 2)
  total                   Decimal          @default(0) @db.Decimal(10, 2)
  payment_method_id       Int?
  payment_screenshot_id   Int?
  watermark_id            Int?
  purchase_serial         String?          @db.VarChar(255)
  number_transferred_from String?          @db.VarChar(50)
  payment_number          String?          @db.VarChar(50)
  notes                   String?
  admin_notes             String?
  admin_note_by           Int?
  received_at             DateTime?        @db.Timestamp(6)
  received_by             Int?
  confirmed_at            DateTime?        @db.Timestamp(6)
  confirmed_by            Int?
  returned_at             DateTime?        @db.Timestamp(6)
  returned_by             Int?
  created_at              DateTime?        @default(now()) @db.Timestamp(6)
  updated_at              DateTime?        @db.Timestamp(6)
  deleted_at              DateTime?        @db.Timestamp(6)
  purchase_items          purchase_items[]
  coupon_usages           coupon_usages[]
  users                   users            @relation("PurchaseCreator", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  received_by_user        users?           @relation("PurchaseReceiver", fields: [received_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  confirmed_by_user       users?           @relation("PurchaseConfirmer", fields: [confirmed_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  returned_by_user        users?           @relation("PurchaseReturner", fields: [returned_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  payment_methods         payment_methods? @relation(fields: [payment_method_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  payment_screenshot      images?          @relation("PurchasePaymentScreenshot", fields: [payment_screenshot_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  watermark               images?          @relation("PurchaseWatermark", fields: [watermark_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([user_id], map: "ix_purchases_user_id")
  @@index([status], map: "ix_purchases_status")
  @@index([created_at], map: "ix_purchases_created_at")
  @@index([purchase_serial], map: "ix_purchases_serial")
}

model purchase_items {
  id                            Int                             @id @default(autoincrement())
  purchase_id                   Int
  product_id                    Int
  price_at_purchase             Decimal                         @default(0) @db.Decimal(10, 2)
  discount                      Decimal                         @default(0) @db.Decimal(10, 2)
  required_fields_filled        Boolean                         @default(false)
  created_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  updated_at                    DateTime?                       @db.Timestamp(6)
  deleted_at                    DateTime?                       @db.Timestamp(6)
  purchases                     purchases                       @relation(fields: [purchase_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products                      products                        @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchase_item_required_fields purchase_item_required_fields[]
}

model purchase_item_required_fields {
  id                         Int                        @id @default(autoincrement())
  purchase_item_id           Int
  field_definition_id        Int
  value                      String
  created_at                 DateTime?                  @default(now()) @db.Timestamp(6)
  updated_at                 DateTime?                  @db.Timestamp(6)
  purchase_items             purchase_items             @relation(fields: [purchase_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  required_field_definitions required_field_definitions @relation(fields: [field_definition_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model payment_methods {
  id           Int         @id @default(autoincrement())
  name         String      @db.VarChar(255)
  phone_number String      @db.VarChar(50)
  status       Boolean?    @default(true)
  image_id     Int?
  created_at   DateTime?   @default(now()) @db.Timestamp(6)
  updated_at   DateTime?   @db.Timestamp(6)
  deleted_at   DateTime?   @db.Timestamp(6)
  images       images?     @relation(fields: [image_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  purchases    purchases[]
}

enum auth_provider_enum {
  local
  firebase
  google
  facebook
}

enum gender_enum {
  male
  female
}

enum portal_enum {
  store
  academy
}

enum role_enum {
  Admin
  SubAdmin
  Teacher
  Student
  Parent
  Lecturer
  Moderator
  Assistant
}

enum field_type_enum {
  text
  number
  date
  image
}

enum image_mime_type_enum {
  jpeg
  png
  webp
  gif
  svg
  avif
}

enum product_type_enum {
  Book
  Product
}

enum location_type_enum {
  School
  Center
}

model images {
  id            Int                  @id @default(autoincrement())
  url           String
  original_name String               @db.VarChar(255)
  mime_type     image_mime_type_enum
  size          Int
  created_at    DateTime?            @default(now()) @db.Timestamp(6)

  product_thumbnail           products[]        @relation("ProductThumbnail")
  product_gallery             product_gallery[]
  purchase_watermark          purchases[]       @relation("PurchaseWatermark")
  purchase_payment_screenshot purchases[]       @relation("PurchasePaymentScreenshot")
  payment_methods             payment_methods[] // <-- Added opposite relation for payment_methods
}

model product_gallery {
  id         Int       @id @default(autoincrement())
  product_id Int
  image_id   Int
  sort_order Int?      @default(0)
  active     Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  products products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  images   images   @relation(fields: [image_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, image_id])
}
