# Optional backend-local env file.
# The backend also loads ../.env, so most projects should copy kalima-platform/.env.example to kalima-platform/.env instead.

PORT=5001
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/DB_NAME?schema=public
JWT_SECRET=replace-with-long-random-secret
ACCESS_TOKEN_SECRET=replace-with-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-long-random-secret
FIREBASE_AUTH_LOCAL_DEV_BYPASS=true
