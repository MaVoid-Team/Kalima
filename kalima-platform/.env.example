# Copy this file to .env and fill in real values.
# Backend dev commands run from backend/, but backend now also loads this file.

# App
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SUPPORT_URL=http://localhost:5173/support

# Frontend API URL, also duplicated in frontend/.env.local for Vite.
VITE_API_URL=http://localhost:5000/api/v2

# Error monitoring
SENTRY_DSN=https://048ba305ef0a02edfe7c9a2b46b16b50@o4511636173488128.ingest.de.sentry.io/4511636192100432
VITE_SENTRY_DSN=https://048ba305ef0a02edfe7c9a2b46b16b50@o4511636173488128.ingest.de.sentry.io/4511636192100432
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Postgres for the TypeScript store API.
# If you use the Kalima VPS tunnel, point this at the local forwarded port.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/DB_NAME?schema=public

# Redis is optional for local boot; notification consumers start only when present.
REDIS_URL=redis://127.0.0.1:6379

# Auth / app secrets
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_DAYS=30
ACCESS_TOKEN_SECRET=replace-with-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-long-random-secret
APP_SECRET=replace-with-long-random-secret

# E-booklet security
E_BOOKLET_ACCESS_CODE_SECRET=replace-with-long-random-secret
E_BOOKLET_PAGE_TOKEN_SECRET=replace-with-long-random-secret
E_BOOKLET_INVITE_TOKEN_SECRET=replace-with-long-random-secret
E_BOOKLET_INVITE_PASSCODE_SECRET=replace-with-long-random-secret
E_BOOKLET_PASSCODE_PEPPER=replace-with-long-random-secret
E_BOOKLET_UPLOAD_DIR=uploads/e-booklets/private

# Firebase backend admin. Use real service account values, or keep bypass for local-only dev.
FIREBASE_PROJECT_ID=kalima-a5325
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_AUTH_LOCAL_DEV_BYPASS=true

# Email
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Google service account
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Initial admin seed
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_GENDER=male
